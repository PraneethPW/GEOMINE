# Copy to backend/.env. Never commit the populated file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
DATABASE_SCHEMA=geomine
ENABLE_REGISTRATION=true
# Optional: enables the 10m Planetary Computer radar source.
# When empty, physical analysis uses public Digital Earth Africa RTC on a 30m grid.
PC_SUBSCRIPTION_KEY=
# Only the backend receives the AI key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Install real trained artifacts on the worker; paths must exist on each service using them.
MODEL_PATH=
MODEL_MANIFEST_PATH=
MAX_AOI_KM2=100
JOB_TIMEOUT_SECONDS=1800

# Managed identity: these values enable Firebase sign-in. Private key goes only to API.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Private operator health token, at least 32 random characters. API only.
OPERATIONS_TOKEN=
# Operator backup machine only: base64-encoded random 32-byte key.
BACKUP_ENCRYPTION_KEY=
